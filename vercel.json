{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/studio", "destination": "/studio.html" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/api/cron/supabase-keepalive",
      "schedule": "17 3 * * *"
    }
  ]
}
